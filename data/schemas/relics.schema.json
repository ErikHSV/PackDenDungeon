{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "relics.schema.json",
  "title": "Relikte",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "rarity",
      "symbol",
      "beschreibung",
      "ausloeser",
      "aktion",
      "verflucht"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "rarity": {
        "$ref": "common.schema.json#/definitions/seltenheit"
      },
      "symbol": {
        "type": "string"
      },
      "beschreibung": {
        "type": "string"
      },
      "ausloeser": {
        "enum": [
          "passiv",
          "runStart",
          "packGeoeffnet",
          "heldGestorben",
          "kill",
          "turmGetroffen",
          "tomeGenutzt",
          "bossErscheint"
        ]
      },
      "aktion": {
        "type": "object",
        "required": [
          "typ"
        ],
        "properties": {
          "typ": {
            "enum": [
              "wert",
              "giftwolke",
              "wiederbeleben",
              "verstaerken",
              "rueckschaden",
              "werte"
            ]
          }
        }
      },
      "verflucht": {
        "type": "boolean"
      },
      "nachteil": {
        "type": "string"
      }
    }
  }
}
