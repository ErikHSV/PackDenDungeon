{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "quests.schema.json",
  "title": "Quests",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "beschreibung",
      "ziel",
      "belohnung"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "beschreibung": {
        "type": "string"
      },
      "ziel": {
        "type": "object",
        "required": [
          "statistik",
          "anzahl"
        ],
        "properties": {
          "statistik": {
            "enum": [
              "packsGeoeffnet",
              "foilsGezogen",
              "kills",
              "bossBesiegt",
              "tomesGenutzt",
              "entwicklungen",
              "laengsterRun",
              "grenzgaengerGezogen",
              "killsGegner",
              "runs"
            ]
          },
          "filter": {
            "type": "object"
          },
          "anzahl": {
            "type": "number"
          }
        }
      },
      "belohnung": {
        "type": "object",
        "properties": {
          "tagesEinkommen": {
            "type": "number"
          },
          "kristalle": {
            "type": "number"
          },
          "reliktpack": {
            "type": "integer"
          },
          "freischaltung": {
            "type": "string"
          }
        }
      }
    }
  }
}
