{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "starmap.schema.json",
  "title": "Sternenkarte (Skill-Tree)",
  "type": "object",
  "required": [
    "groesse",
    "start",
    "aeste",
    "knoten"
  ],
  "properties": {
    "groesse": {
      "type": "object",
      "required": [
        "breite",
        "hoehe"
      ]
    },
    "start": {
      "type": "string"
    },
    "aeste": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "farbe"
        ]
      }
    },
    "knoten": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "beschreibung",
          "typ",
          "ast",
          "position",
          "verbindungen",
          "maxStufe",
          "basisKosten",
          "kostenFaktor",
          "kristallKosten",
          "effekt",
          "akt",
          "waehrung"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "beschreibung": {
            "type": "string"
          },
          "typ": {
            "enum": [
              "start",
              "klein",
              "gross",
              "schluessel",
              "freischalt"
            ],
            "description": "klein = Kreis, gross = Sechseck, schluessel = Stern (MP + Kristalle), freischalt = Schloss"
          },
          "ast": {
            "type": "string"
          },
          "position": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          },
          "verbindungen": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "maxStufe": {
            "type": "integer",
            "minimum": 1
          },
          "basisKosten": {
            "type": "number"
          },
          "kostenFaktor": {
            "type": "number"
          },
          "kristallKosten": {
            "type": "number"
          },
          "symbol": {
            "type": "string"
          },
          "effekt": {
            "type": "object",
            "required": [
              "ziel"
            ],
            "properties": {
              "ziel": {
                "type": "string"
              },
              "wert": {
                "type": "number"
              },
              "rechenart": {
                "enum": [
                  "addieren",
                  "multiplizieren"
                ]
              },
              "flag": {
                "type": "string"
              },
              "karte": {
                "type": "string"
              },
              "gebaeude": {
                "type": "string"
              },
              "patches": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/definitions/patch"
                }
              }
            }
          },
          "voraussetzung": {
            "type": "object",
            "properties": {
              "karte": {
                "type": "string"
              }
            }
          },
          "akt": {
            "type": "integer",
            "description": "1 = von Anfang an, 2 = erst nach dem Tor sichtbar"
          },
          "waehrung": {
            "enum": [
              "mastery",
              "foilstaub"
            ]
          }
        }
      }
    }
  }
}
