{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "shop.schema.json",
  "title": "Shop-Angebote",
  "type": "object",
  "required": [
    "angebote"
  ],
  "properties": {
    "angebote": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "artikel",
          "anzahl",
          "grundPreis",
          "gewicht"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "artikel": {
            "type": "string"
          },
          "anzahl": {
            "type": "integer"
          },
          "grundPreis": {
            "type": "number"
          },
          "stufe": {
                "type": "integer",
                "minimum": 0
              },
              "gewicht": {
            "type": "number"
          }
        }
      }
    }
  }
}
