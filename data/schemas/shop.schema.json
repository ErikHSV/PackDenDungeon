{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "shop.schema.json",
  "title": "Shop-Angebote",
  "type": "object",
  "required": [
    "angebote",
    "jackpots"
  ],
  "properties": {
    "angebote": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "artikel",
          "anzahl",
          "grundPreis",
          "gewicht"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "artikel": {
            "type": "string"
          },
          "anzahl": {
            "type": "integer"
          },
          "grundPreis": {
            "type": "number"
          },
          "gewicht": {
            "type": "number"
          }
        }
      }
    },
    "jackpots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "inhalt",
          "grundPreis",
          "gewicht"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "grundPreis": {
            "type": "number"
          },
          "gewicht": {
            "type": "number"
          },
          "inhalt": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "artikel",
                "anzahl"
              ]
            }
          }
        }
      }
    }
  }
}
