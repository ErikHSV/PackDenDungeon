{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "enemies.schema.json",
  "title": "Gegner und Bosse",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "beschreibung",
      "leben",
      "tempo",
      "ruestung",
      "magieResistenz",
      "fliegt",
      "immun",
      "schaden",
      "angriffsIntervall",
      "groesse",
      "farbe",
      "sprite",
      "eigenschaften"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "boss": {
        "type": "boolean"
      },
      "beschreibung": {
        "type": "string"
      },
      "leben": {
        "type": "number"
      },
      "tempo": {
        "type": "number"
      },
      "ruestung": {
        "type": "number"
      },
      "magieResistenz": {
        "type": "number"
      },
      "fliegt": {
        "type": "boolean"
      },
      "immun": {
        "type": "array",
        "items": {
          "enum": [
            "physical",
            "magic"
          ]
        }
      },
      "schaden": {
        "type": "number"
      },
      "angriffsIntervall": {
        "type": "number"
      },
      "groesse": {
        "enum": [
          24,
          32,
          48,
          96,
          112,
          128
        ],
        "description": "Pixelgröße der Grafik (vor ×3-Skalierung bei 24/32, Bosse ab 96 direkt)"
      },
      "farbe": {
        "$ref": "common.schema.json#/definitions/farbe"
      },
      "sprite": {
        "type": "string"
      },
      "gruppe": {
        "type": "integer"
      },
      "eigenschaften": {
        "type": "object",
        "propertyNames": {
          "enum": [
            "masteryStehlen",
            "explodiertBeimTod",
            "frontSchild",
            "teiltSichBeimTod",
            "verlangsamtHelden",
            "fernkampf",
            "aura",
            "schatztraeger",
            "zumTurm",
            "getarnt"
          ]
        }
      },
      "bossFaehigkeiten": {
        "type": "object",
        "propertyNames": {
          "enum": [
            "schockwelle",
            "beschwoeren",
            "schrei",
            "hammerwurf",
            "einfrieren"
          ]
        }
      },
      "phasen": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "lebenUnter"
          ],
          "properties": {
            "lebenUnter": {
              "type": "number"
            },
            "text": {
              "type": "string"
            },
            "tempoMul": {
              "type": "number"
            },
            "patches": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/definitions/patch"
              }
            },
            "beschwoeren": {
              "type": "array"
            }
          }
        }
      },
      "formation": {
        "type": "array",
        "items": {
          "type": "integer"
        },
        "description": "Formation [min, max]: erscheinen als Trupp in Reihen"
      },
      "fraktion": {
        "type": "string"
      }
    }
  }
}
