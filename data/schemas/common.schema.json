{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common.schema.json",
  "title": "Gemeinsame Definitionen",
  "definitions": {
    "seltenheit": {
      "enum": [
        "common",
        "uncommon",
        "rare",
        "epic",
        "legendary",
        "grenzgaenger"
      ]
    },
    "patch": {
      "type": "object",
      "required": [
        "pfad",
        "op",
        "wert"
      ],
      "description": "Ändert einen Wert per Punkt-Pfad (z. B. 'werte.schaden')",
      "properties": {
        "pfad": {
          "type": "string"
        },
        "op": {
          "enum": [
            "set",
            "add",
            "mul"
          ]
        },
        "wert": {}
      }
    },
    "status": {
      "type": "object",
      "required": [
        "typ"
      ],
      "properties": {
        "typ": {
          "enum": [
            "verlangsamung",
            "betaeubung",
            "brennen",
            "gift",
            "seuche",
            "verwundbarkeit",
            "rueckstoss"
          ]
        },
        "dauer": {
          "type": "number"
        },
        "faktor": {
          "type": "number"
        },
        "schadenProSekunde": {
          "type": "number"
        },
        "anteil": {
          "type": "number"
        },
        "distanz": {
          "type": "number"
        },
        "chance": {
          "type": "number"
        },
        "explosionSchaden": {
          "type": "number"
        },
        "explosionRadius": {
          "type": "number"
        }
      }
    },
    "farbe": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    }
  }
}
