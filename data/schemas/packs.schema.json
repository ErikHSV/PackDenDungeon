{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "packs.schema.json",
  "title": "Booster-Packs",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "description", "unlockChapter", "basePrice", "color", "rarityWeights", "pool"],
    "properties": {
      "id": { "type": "string" },
      "name": { "type": "string" },
      "description": { "type": "string" },
      "unlockChapter": { "type": "integer", "minimum": 1 },
      "basePrice": { "type": "number" },
      "color": { "type": "string" },
      "rarityWeights": { "type": "object", "description": "Gewichte je Seltenheit; Karte wird danach gleichverteilt aus dem Pool dieser Seltenheit gezogen" },
      "pool": { "type": "array", "items": { "type": "string" }, "description": "IDs von Helden und Zaubern" }
    }
  }
}
