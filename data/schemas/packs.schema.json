{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "packs.schema.json",
  "title": "Packs, Kisten und Reliktpacks",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "art",
      "beschreibung",
      "farbe",
      "freischaltung"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "art": {
        "enum": [
          "pack",
          "kiste",
          "relikt"
        ]
      },
      "beschreibung": {
        "type": "string"
      },
      "farbe": {
        "$ref": "common.schema.json#/definitions/farbe"
      },
      "freischaltung": {
        "type": "object",
        "required": [
          "typ"
        ],
        "properties": {
          "typ": {
            "enum": [
              "start",
              "boss",
              "knoten",
              "foilknoten",
              "quelle",
              "geplant"
            ]
          },
          "kapitel": {
            "type": "integer"
          },
          "quellen": {
            "type": "array",
            "items": {
              "enum": [
                "jackpot",
                "quest",
                "reliktjagd"
              ]
            }
          },
          "knoten": {
            "type": "string"
          }
        }
      },
      "widerstand": {
        "type": "number"
      },
      "kartenProPack": {
        "type": "integer"
      },
      "pool": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "IDs aus units.json und tomes.json"
      },
      "seltenheitsGewichte": {
        "type": "object"
      },
      "inhalt": {
        "type": "object",
        "properties": {
          "pack": {
            "type": "string"
          },
          "anzahl": {
            "type": "integer"
          },
          "relikte": {
            "type": "integer"
          },
          "auswahl": {
            "type": "integer"
          }
        }
      },
      "nurFehlende": {
        "type": "boolean",
        "description": "Glanzpack: zieht gezielt seltene, noch nicht gefundene Karten (pool bleibt leer)."
      }
    }
  }
}
