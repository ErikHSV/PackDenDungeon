{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "buildings.schema.json",
  "title": "Gebäude",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "beschreibung",
      "farbe",
      "pack",
      "position",
      "stufen"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "beschreibung": {
        "type": "string"
      },
      "farbe": {
        "$ref": "common.schema.json#/definitions/farbe"
      },
      "pack": {
        "type": "string"
      },
      "kiste": {
        "type": [
          "string",
          "null"
        ]
      },
      "position": {
        "type": "object",
        "required": [
          "winkel"
        ],
        "properties": {
          "winkel": {
            "type": "number"
          }
        }
      },
      "stufen": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "intervall",
            "kistenChance"
          ],
          "properties": {
            "intervall": {
              "type": "number"
            },
            "kistenChance": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
