{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "chapters.schema.json",
  "title": "Kapitel",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "akt",
      "name",
      "intro",
      "boden",
      "bossNachSekunden",
      "spawn",
      "wellen",
      "gegner",
      "boss",
      "gefahren"
    ],
    "properties": {
      "id": {
        "type": "integer"
      },
      "akt": {
        "type": "integer"
      },
      "name": {
        "type": "string"
      },
      "intro": {
        "type": "string"
      },
      "boden": {
        "type": "object",
        "required": [
          "grund",
          "akzent",
          "detail"
        ]
      },
      "bossNachSekunden": {
        "type": "number"
      },
      "spawn": {
        "type": "object",
        "required": [
          "modus"
        ],
        "properties": {
          "modus": {
            "enum": [
              "ring",
              "portale"
            ]
          },
          "portale": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "winkel"
              ]
            }
          }
        }
      },
      "wellen": {
        "type": "object",
        "properties": {
          "lebenMul": {
            "type": "number"
          },
          "muenzenMul": {
            "type": "number"
          },
          "schadenMul": {
            "type": "number"
          }
        }
      },
      "gegner": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "gewicht"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "gewicht": {
              "type": "number"
            },
            "abSekunde": {
              "type": "number"
            },
            "bisSekunde": {
              "type": "number"
            }
          }
        }
      },
      "boss": {
        "type": "string"
      },
      "gefahren": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "typ"
          ],
          "properties": {
            "typ": {
              "enum": [
                "schneesturm"
              ]
            }
          }
        }
      }
    }
  }
}
