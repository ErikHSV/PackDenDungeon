{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rarities.schema.json",
  "title": "Seltenheiten",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": [
      "name",
      "farbe",
      "rang"
    ],
    "properties": {
      "name": {
        "type": "string"
      },
      "farbe": {
        "$ref": "common.schema.json#/definitions/farbe"
      },
      "rang": {
        "type": "integer"
      },
      "lichtblitz": {
        "type": "boolean"
      },
      "zeitlupe": {
        "type": "boolean"
      },
      "geheim": {
        "type": "boolean"
      }
    }
  }
}
