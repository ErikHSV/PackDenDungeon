{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "acts.schema.json",
  "title": "Akte und das Tor",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "kapitel"
    ],
    "properties": {
      "id": {
        "type": "integer"
      },
      "name": {
        "type": "string"
      },
      "kapitel": {
        "type": "array",
        "items": {
          "type": "integer"
        }
      },
      "sonder": {
        "type": "array",
        "items": {
          "type": "integer"
        }
      },
      "status": {
        "enum": [
          "geplant",
          "teilweise",
          "fertig"
        ]
      },
      "geplant": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "tor": {
        "type": "object",
        "required": [
          "name",
          "knoten"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "beschreibung": {
            "type": "string"
          },
          "warnung": {
            "type": "string"
          },
          "knoten": {
            "type": "string",
            "description": "Tor-Knoten im Skill-Tree"
          }
        }
      }
    }
  }
}
